{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit successful training process receipt",
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "const": "SUCCEEDED"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "net": {
            "$ref": "#/$defs/artifact"
          },
          "source": {
            "$ref": "#/$defs/artifact"
          }
        },
        "required": [
          "net",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "status",
    "input_sha256",
    "exports"
  ],
  "additionalProperties": false
}
