{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit stage reservation admission",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "WAITING",
              "ADMITTED",
              "REVOKED"
            ]
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stage": {
            "enum": [
              "train",
              "gate"
            ]
          },
          "cpus": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "ticket": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "input_sha256",
          "stage",
          "cpus",
          "ticket"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "jobs"
  ],
  "additionalProperties": false
}
