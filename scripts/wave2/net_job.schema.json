{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "net_job.schema.json",
  "title": "Training, await-result and fixed net gate jobs",
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          },
          "required": [
            "source"
          ]
        },
        "prerequisite": {
          "$ref": "#/$defs/artifact"
        },
        "stage": {
          "const": "train"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "version",
        "id",
        "stage",
        "inputs",
        "argv"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "prerequisite": {
          "$ref": "#/$defs/artifact"
        },
        "stage": {
          "const": "await-result"
        },
        "training": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "net_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "input_sha256",
            "export",
            "net_sha256",
            "source_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "stage",
        "inputs",
        "training"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          },
          "required": [
            "base_source",
            "base_net"
          ]
        },
        "prerequisite": {
          "$ref": "#/$defs/artifact"
        },
        "stage": {
          "const": "gate"
        },
        "training": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "net_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "input_sha256",
            "export",
            "net_sha256",
            "source_sha256"
          ],
          "additionalProperties": false
        },
        "book": {
          "$ref": "#/$defs/artifact"
        },
        "claim_books": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "retention_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "evaluator_exception": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^engine/(ngnn[^/]*|worker_evaluator)\\.go$"
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "files",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "stage",
        "inputs",
        "training",
        "book",
        "claim_books",
        "retention_bytes"
      ],
      "additionalProperties": false
    }
  ]
}
