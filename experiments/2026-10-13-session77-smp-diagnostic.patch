+
+// Campaign-only instrumentation; this file never enters a playing binary.
+func campaignDiagnosticOptions(h *smpSearchHooks, worker int, opts iterativeSearchOptions) iterativeSearchOptions {
+    if h == nil { return opts }
+    if h.diagnosticIteration != nil { opts.diagnosticIteration = func(i *SearchInfo){h.diagnosticIteration(worker,i)} }
+    if h.diagnosticVisit != nil { opts.diagnosticVisit = func(key uint64,d int){h.diagnosticVisit(worker,key,d)} }
+    return opts
+}
