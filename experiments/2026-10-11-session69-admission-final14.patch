--- /dev/null
+++ b/engine/time_admission_test.go
@@ -0,0 +1,65 @@
+package engine
+
+import (
+	"testing"
+	"time"
+)
+
+func TestIterationAdmissionChecksClockWithoutThrottle(t *testing.T) {
+	start := time.Unix(123, 0)
+	clock := &terminationObserverClock{now: start.Add(801 * time.Millisecond)}
+	var observer searchTerminationObserver
+	tm := configuredObserverTournament(clock, &observer)
+	tm.startTime = start
+	tm.checkCounter = 0
+	if !tm.shouldStopSearchAt(7, timeCheckIterationAdmission) {
+		t.Fatal("expired soft projection admitted another depth")
+	}
+	if observer.FirstReason != searchTerminationSoftAdmission {
+		t.Fatalf("reason=%v", observer.FirstReason)
+	}
+}
+
+func TestIterationAdmissionChecksHardDeadlineWithoutThrottle(t *testing.T) {
+	start := time.Unix(123, 0)
+	clock := &terminationObserverClock{now: start.Add(4 * time.Second)}
+	var observer searchTerminationObserver
+	tm := configuredObserverTournament(clock, &observer)
+	tm.startTime = start
+	tm.checkCounter = 0
+	if !tm.shouldStopSearchAt(7, timeCheckIterationAdmission) || observer.FirstReason != searchTerminationHardDeadline {
+		t.Fatalf("missed hard admission deadline: %+v", observer)
+	}
+}
+
+func TestIterationAdmissionLeavesActiveChecksThrottled(t *testing.T) {
+	start := time.Unix(123, 0)
+	clock := &terminationObserverClock{now: start.Add(801 * time.Millisecond)}
+	var observer searchTerminationObserver
+	tm := configuredObserverTournament(clock, &observer)
+	tm.startTime = start
+	tm.checkCounter = 0
+	for i := 0; i < 1023; i++ {
+		if tm.ShouldStopSearch(7) {
+			t.Fatalf("active check %d lost throttle", i+1)
+		}
+	}
+	if !tm.ShouldStopSearch(7) || observer.FirstReason != searchTerminationSoftAbort {
+		t.Fatalf("active check did not retain its soft stop: %+v", observer)
+	}
+}
+
+func TestIterationAdmissionBeforeBudgetKeepsSearching(t *testing.T) {
+	start := time.Unix(123, 0)
+	clock := &terminationObserverClock{now: start.Add(100 * time.Millisecond)}
+	var observer searchTerminationObserver
+	tm := configuredObserverTournament(clock, &observer)
+	tm.startTime = start
+	tm.checkCounter = 0
+	if tm.shouldStopSearchAt(7, timeCheckIterationAdmission) {
+		t.Fatal("early admission stopped search")
+	}
+	if tm.lastTimeCheck != clock.now || tm.checkCounter != 1 || observer.FirstReason != searchTerminationNone {
+		t.Fatal("admission did not observe current clock")
+	}
+}
