+package engine
+
+import "testing"
+
+func TestRecursiveSearchRestoresFrameState(t *testing.T) {
+	for _, mode := range []string{"main", "quiescence"} {
+		for _, panicEval := range []bool{false, true} {
+			name := mode + "/return"
+			if panicEval {
+				name = mode + "/panic"
+			}
+			t.Run(name, func(t *testing.T) {
+				pos, info := newProbcutContractState(t, 2)
+				before := snapshotPVPosition(pos)
+				info.FrameDepth = 2
+				info.RepStack[0], info.RepStack[1], info.RepStackLen = 0x1234, 0x5678, 2
+				const marker = "epilogue test evaluator panic"
+				if panicEval {
+					info.evaluator.staticOracle = func(*Position) int { panic(marker) }
+				}
+				var recovered any
+				func() {
+					defer func() { recovered = recover() }()
+					if mode == "main" {
+						alphaBetaPV(pos, 2, 2, -INFINITY, INFINITY, true, true, false, info)
+					} else {
+						quiescenceWithDepth(pos, -INFINITY, INFINITY, 2, info, 0)
+					}
+				}()
+				if panicEval && recovered != marker {
+					t.Fatalf("panic = %v, want %q", recovered, marker)
+				}
+				if !panicEval && recovered != nil {
+					t.Fatalf("unexpected panic: %v", recovered)
+				}
+				requireProbcutSearchUnwound(t, pos, before, info, EmptyMove, 2, 2)
+				if info.RepStack[0] != 0x1234 || info.RepStack[1] != 0x5678 {
+					t.Fatal("search overwrote the caller's repetition entries")
+				}
+			})
+		}
+	}
+}
