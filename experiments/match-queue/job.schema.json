{
  "type": "object",
  "required": [
    "version",
    "id",
    "base",
    "candidate",
    "bounds",
    "time_control",
    "book",
    "min_games",
    "max_games",
    "concurrency"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "base": {
      "type": "object",
      "required": [
        "source_hash",
        "binary",
        "net",
        "options"
      ],
      "properties": {
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "net": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "source_hash",
        "binary",
        "net",
        "options"
      ],
      "properties": {
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "net": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "elo0",
        "elo1",
        "alpha",
        "beta"
      ],
      "properties": {
        "elo0": {
          "type": "number"
        },
        "elo1": {
          "type": "number"
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "beta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    },
    "time_control": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(\\+[0-9]+(\\.[0-9]+)?)?$"
    },
    "book": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "min_games": {
      "type": "integer",
      "minimum": 2
    },
    "max_games": {
      "type": "integer",
      "minimum": 2
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
