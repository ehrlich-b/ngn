+package engine
+
+import "testing"
+
+func TestTTFirstValidatorOracle(t *testing.T) {
+	for _, fen := range []string{
+		"r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+		"7k/8/8/3pP3/8/8/8/K7 w - d6 0 1",
+		"7k/P7/8/8/8/8/8/K7 w - - 0 1",
+		"4r2k/8/8/8/8/8/4R3/4K3 w - - 0 1",
+	} {
+		pos, _ := newProbcutContractStateForFEN(t, fen, 1)
+		var moves [256]Move
+		n := GenerateMovesIntoBuffer(pos, moves[:])
+		for _, move := range moves[:n] {
+			if got, want := ttMoveGeneratedLegal(pos, move), IsLegalMove(pos, move); got != want {
+				t.Errorf("%s %s: got %v want %v", fen, move.ToString(), got, want)
+			}
+			// A high unused bit must not be accepted as an otherwise valid move.
+			if ttMoveGeneratedLegal(pos, move|Move(1<<31)) {
+				t.Errorf("%s accepted mutated %s", fen, move.ToString())
+			}
+		}
+		if ttMoveGeneratedLegal(pos, EmptyMove) {
+			t.Errorf("%s accepted empty move", fen)
+		}
+	}
+}
+
+// ttMoveGeneratedLegal is a reference validator for a transposition-table move.
+// It verifies the complete packed representation against the generator before
+// calling IsLegalMove, which assumes its input is pseudo-legal. This deliberately
+// generates moves and is therefore an oracle, not a TT-first implementation.
+func ttMoveGeneratedLegal(pos *Position, move Move) bool {
+	if move == EmptyMove {
+		return false
+	}
+	var moves [256]Move
+	n := GenerateMovesIntoBuffer(pos, moves[:])
+	for _, candidate := range moves[:n] {
+		if candidate == move {
+			return IsLegalMove(pos, move)
+		}
+	}
+	return false
+}
