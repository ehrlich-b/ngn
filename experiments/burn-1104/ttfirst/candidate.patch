+package engine
+
+// ttMovePseudoLegal checks the entire packed move without generating a list.
+// IsLegalMove is only safe after these structural checks (especially castle/EP).
+func ttMovePseudoLegal(pos *Position, m Move) bool {
+	if m == EmptyMove || uint32(m)>>27 != 0 {
+		return false
+	}
+	from, to, p := m.Source(), m.Destination(), m.MovingPiece()
+	if from == to || p < WhitePawn || p > BlackKing || p.Color() != pos.Turn() || pos.Board.PieceAt(from) != p {
+		return false
+	}
+	target := pos.Board.PieceAt(to)
+	if target != NoPiece && (target.Color() == p.Color() || target.Type() == King) {
+		return false
+	}
+	occupied := pos.Board.WhiteOccupancy() | pos.Board.BlackOccupancy()
+	mask := SquareMask[int(to)]
+	if m.IsCastle() {
+		if p.Type() != King || target != NoPiece || m.CapturedPiece() != NoPiece || m.PromoType() != NoType {
+			return false
+		}
+		start, rook, dest, path, right := E1, H1, G1, uint64(1<<F1|1<<G1), WhiteCanCastleKingSide
+		if m.Tag() == QueenSideCastle {
+			rook, dest, path, right = A1, C1, 1<<B1|1<<C1|1<<D1, WhiteCanCastleQueenSide
+		} else if m.Tag() != KingSideCastle {
+			return false
+		}
+		if p.Color() == Black {
+			start, rook, dest, path = start+56, rook+56, dest+56, path<<56
+			if m.Tag() == KingSideCastle {
+				right = BlackCanCastleKingSide
+			} else {
+				right = BlackCanCastleQueenSide
+			}
+		}
+		return from == start && to == dest && pos.HasTag(right) && occupied&path == 0 && pos.Board.PieceAt(rook) == GetPiece(Rook, p.Color())
+	}
+	if m.IsEnPassant() {
+		step, rank := 8, 5
+		if p.Color() == Black {
+			step, rank = -8, 2
+		}
+		df := int(to.File()) - int(from.File())
+		return p.Type() == Pawn && m.Tag() == EnPassant|Capture && m.PromoType() == NoType && to == pos.EnPassant && int(to.Rank()) == rank && target == NoPiece && m.CapturedPiece() == GetPiece(Pawn, p.Color().Other()) && pos.Board.PieceAt(Square(int(to)-step)) == m.CapturedPiece() && (df == 1 || df == -1) && int(to)-int(from) == step+df
+	}
+	tag := MoveTag(0)
+	if target != NoPiece {
+		tag = Capture
+	}
+	if m.Tag() != tag || m.CapturedPiece() != target {
+		return false
+	}
+	if p.Type() != Pawn && m.PromoType() != NoType {
+		return false
+	}
+	switch p.Type() {
+	case Knight:
+		return KnightAttacks[from]&mask != 0
+	case Bishop:
+		return getBishopAttacksBB(int(from), occupied)&mask != 0
+	case Rook:
+		return getRookAttacksBB(int(from), occupied)&mask != 0
+	case Queen:
+		return (getBishopAttacksBB(int(from), occupied)|getRookAttacksBB(int(from), occupied))&mask != 0
+	case King:
+		return KingAttacks[from]&mask != 0
+	case Pawn:
+		step, start, last := 8, 1, 7
+		if p.Color() == Black {
+			step, start, last = -8, 6, 0
+		}
+		promo := m.PromoType()
+		if int(to.Rank()) == last {
+			if promo != Queen && promo != Rook && promo != Bishop && promo != Knight {
+				return false
+			}
+		} else if promo != NoType {
+			return false
+		}
+		delta, df := int(to)-int(from), int(to.File())-int(from.File())
+		if target != NoPiece {
+			return (df == 1 || df == -1) && delta == step+df
+		}
+		return df == 0 && (delta == step || (delta == 2*step && int(from.Rank()) == start && pos.Board.PieceAt(Square(int(from)+step)) == NoPiece))
+	}
+	return false
+}
+
+func ttMoveLegal(pos *Position, move Move) bool {
+	return ttMovePseudoLegal(pos, move) && IsLegalMove(pos, move)
+}
+
+// Copy only the ordering inputs for this node, never the live decision/history
+// state. Reused per recursion frame; descendants may mutate all live tables.
+// Copy cost remains subject to the pending timing qualification.
+type ttOrderSnapshot struct {
+	quiet, cont, follow [13][64]int
+	capture             [13][64][13]int
+	killers             [2]Move
+	counter             Move
+	useCont, useFollow  bool
+}
+
+type ttOrderContext struct {
+	quiet, cont, follow *[13][64]int
+	capture             *[13][64][13]int
+	killers             [2]Move
+	counter             Move
+}
+
+func (h *workerHistory) orderContext(ply int, previous, prev2 Move) ttOrderContext {
+	c := ttOrderContext{quiet: &h.historyTable, capture: &h.captureHistory, counter: h.GetCounterMove(previous)}
+	if ply >= 0 && ply < MaximumDepth {
+		c.killers = h.killerMoves[ply]
+	}
+	if previous != EmptyMove {
+		c.cont = &h.continuationHistory[previous.MovingPiece()][previous.Destination()]
+	}
+	if prev2 != EmptyMove {
+		c.follow = &h.followupHistory[prev2.MovingPiece()][prev2.Destination()]
+	}
+	return c
+}
+func (s *ttOrderSnapshot) save(h *workerHistory, ply int, previous, prev2 Move) {
+	c := h.orderContext(ply, previous, prev2)
+	s.quiet, s.capture, s.killers, s.counter = *c.quiet, *c.capture, c.killers, c.counter
+	s.useCont, s.useFollow = c.cont != nil, c.follow != nil
+	if s.useCont {
+		s.cont = *c.cont
+	}
+	if s.useFollow {
+		s.follow = *c.follow
+	}
+}
+func (s *ttOrderSnapshot) context() ttOrderContext {
+	c := ttOrderContext{quiet: &s.quiet, capture: &s.capture, killers: s.killers, counter: s.counter}
+	if s.useCont {
+		c.cont = &s.cont
+	}
+	if s.useFollow {
+		c.follow = &s.follow
+	}
+	return c
+}
