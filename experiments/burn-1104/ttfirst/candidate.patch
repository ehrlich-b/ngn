+package engine
+
+import (
+	"fmt"
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+var ttFirstFENs = []string{
+	"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+	"r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+	"r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1",
+	"7k/8/8/3pP3/8/8/8/K7 w - d6 0 1",
+	"7k/8/8/8/3Pp3/8/8/K7 b - d3 0 1",
+	"7k/P7/8/8/8/8/8/K7 w - - 0 1",
+	"7k/8/8/8/8/8/p7/7K b - - 0 1",
+	"4r2k/8/8/8/8/8/4R3/4K3 w - - 0 1",
+	"4r2k/8/8/8/8/8/8/4K3 w - - 0 1",
+	"7k/8/8/r2pP2K/8/8/8/8 w - d6 0 1",
+	"r1bq1rk1/pp2bppp/2n2n2/2pp4/3P4/2N1PN2/PPQ1BPPP/R1B2RK1 w - - 0 10",
+	"r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+}
+
+func TestTTFirstMutation(t *testing.T) {
+	rng := rand.New(rand.NewSource(1104))
+	positives, rejected := 0, 0
+	for _, fen := range ttFirstFENs {
+		pos := n3cPosition(t, fen)
+		before := snapshotPVPosition(pos)
+		moves := GenerateMoves(pos)
+		for _, m := range moves {
+			if got, want := ttMovePseudoLegal(pos, m), true; got != want {
+				t.Fatalf("pseudo %s %s", fen, m.ToString())
+			}
+			if got, want := ttMoveLegal(pos, m), ttMoveGeneratedLegal(pos, m); got != want {
+				t.Fatalf("legal %s %s got=%v want=%v", fen, m.ToString(), got, want)
+			}
+			if ttMoveLegal(pos, m) {
+				positives++
+			}
+			for bit := 0; bit < 32; bit++ {
+				bad := m ^ Move(1<<bit)
+				if got, want := ttMoveLegal(pos, bad), ttMoveGeneratedLegal(pos, bad); got != want {
+					t.Fatalf("bit %d %s move=%08x got=%v want=%v", bit, fen, bad, got, want)
+				}
+				if !ttMoveLegal(pos, bad) {
+					rejected++
+				}
+			}
+		}
+		for i := 0; i < 512; i++ {
+			m := Move(rng.Uint32())
+			if ttMoveLegal(pos, m) != ttMoveGeneratedLegal(pos, m) {
+				t.Fatalf("random packed move %08x", m)
+			}
+		}
+		if !reflect.DeepEqual(before, snapshotPVPosition(pos)) {
+			t.Fatal("validator changed position")
+		}
+	}
+	if positives < 100 || rejected < 1000 {
+		t.Fatal("vacuous controls")
+	}
+	t.Logf("seed=1104 legal positives=%d rejected bit mutations=%d random controls=6144", positives, rejected)
+}
+
+func ttSeedHistory(h *workerHistory, previous, prev2 Move) {
+	rng := rand.New(rand.NewSource(1104))
+	for p := 0; p < 13; p++ {
+		for sq := 0; sq < 64; sq++ {
+			// Deliberate ties as well as positive/negative history.
+			h.historyTable[p][sq] = (rng.Intn(5) - 2) * 100
+			h.continuationHistory[previous.MovingPiece()][previous.Destination()][p][sq] = (rng.Intn(3) - 1) * 80
+			h.followupHistory[prev2.MovingPiece()][prev2.Destination()][p][sq] = (rng.Intn(3) - 1) * 60
+			for v := 0; v < 13; v++ {
+				h.captureHistory[p][sq][v] = (rng.Intn(5) - 2) * 64
+			}
+		}
+	}
+}
+
+func TestTTFirstOrder(t *testing.T) {
+	for _, fen := range ttFirstFENs {
+		pos := n3cPosition(t, fen)
+		moves := GenerateMoves(pos)
+		h := new(workerHistory)
+		previous := NewMove(A2, A3, WhitePawn, NoPiece, NoType, 0)
+		prev2 := NewMove(A7, A6, BlackPawn, NoPiece, NoType, 0)
+		ttSeedHistory(h, previous, prev2)
+		for _, tt := range append([]Move{EmptyMove}, moves...) {
+			h.UpdateKillerMoves(moves[0], 2)
+			h.UpdateCounterMove(moves[len(moves)-1], previous)
+			var old, emitted [256]Move
+			var os, ns [256]int
+			n, oi := h.ttReferenceScoreMovesIntoBuffer(moves, 2, previous, prev2, tt, tt != EmptyMove, old[:], os[:], pos, true)
+			snapshot := new(ttOrderSnapshot)
+			snapshot.save(h, 2, previous, prev2)
+			// Simulate a child changing every input. Frozen scores/order must stay exact.
+			h.historyTable[WhitePawn][A3]++
+			nn, ni := snapshot.context().score(moves, tt, tt != EmptyMove, emitted[:], ns[:], pos, true)
+			h.historyTable[WhitePawn][A3]--
+			if n != nn || oi != ni || !reflect.DeepEqual(os[:n], ns[:n]) {
+				t.Fatal("staged scores differ")
+			}
+			if oi >= 0 {
+				old[0], old[oi] = old[oi], old[0]
+				os[0], os[oi] = os[oi], os[0]
+				emitted[0], emitted[ni] = emitted[ni], emitted[0]
+				ns[0], ns[ni] = ns[ni], ns[0]
+			}
+			materializeCaptureScores(old[:], os[:], n, pos)
+			materializeCaptureScores(emitted[:], ns[:], n, pos)
+			var legalOld, legalNew []Move
+			for i := 0; i < n; i++ {
+				if i > 0 || oi < 0 {
+					selectNextMove(old[:], os[:], n, i)
+					selectNextMove(emitted[:], ns[:], n, i)
+				}
+				if old[i] != emitted[i] {
+					t.Fatalf("emitted move/tie order at %d", i)
+				}
+				if IsLegalMove(pos, old[i]) {
+					legalOld = append(legalOld, old[i])
+				}
+				if ttMoveLegal(pos, emitted[i]) {
+					legalNew = append(legalNew, emitted[i])
+				}
+			}
+			if !reflect.DeepEqual(legalOld, legalNew) {
+				t.Fatal("evasion full legal subset/order differs")
+			}
+		}
+	}
+	t.Log("all emitted scores/moves/ties and full legal evasion subsets/orders match pinned oracle")
+}
+
+func ttDecisionState(info *SearchInfo) map[string]interface{} {
+	out := map[string]interface{}{}
+	v := reflect.ValueOf(info).Elem()
+	typ := v.Type()
+	for i := 0; i < v.NumField(); i++ {
+		f := typ.Field(i)
+		x := v.Field(i)
+		if f.PkgPath != "" || f.Name == "TTFirstAttempts" || f.Name == "MainMoveLists" || f.Name == "MainMoveScores" {
+			continue
+		}
+		if x.Kind() != reflect.Slice && x.Kind() != reflect.Pointer && x.Kind() != reflect.Interface && x.Kind() != reflect.Func {
+			out[f.Name] = x.Interface()
+		}
+	}
+	return out
+}
+
+func TestTTFirstCounters(t *testing.T) {
+	cases := 0
+	for fi, fen := range ttFirstFENs {
+		probe := n3cPosition(t, fen)
+		moves := GenerateMoves(probe)
+		seeds := []Move{EmptyMove, Move(1 << 31)}
+		// Every special move, plus ordinary, pinned and check-evasion candidates.
+		for i, m := range moves {
+			if i < 2 || m.IsCastle() || m.IsEnPassant() || m.PromoType() != NoType {
+				seeds = append(seeds, m)
+			}
+		}
+		for si, tt := range seeds {
+			for _, window := range [][2]int{{-1000, 1000}, {-1, 0}, {999, 1000}, {1999, 2000}} {
+				t.Run(fmt.Sprintf("%d/%d/%d", fi, si, window[0]), func(t *testing.T) {
+					p, a := newProbcutContractStateForFEN(t, fen, 2)
+					q, b := newProbcutContractStateForFEN(t, fen, 2)
+					previous := NewMove(A2, A3, WhitePawn, NoPiece, NoType, 0)
+					prev2 := NewMove(A7, A6, BlackPawn, NoPiece, NoType, 0)
+					for _, info := range []*SearchInfo{a, b} {
+						ttSeedHistory(info.history, previous, prev2)
+						if window[0] == 1999 {
+							info.ExcludedMove, info.ExcludedPly = tt, 1
+						}
+						info.history.SetLastMovePlayed(previous)
+						info.MoveStack[0] = prev2
+						if tt != EmptyMove {
+							info.tt.Set(p.Hash(), tt, 0, -1, UpperBound, false)
+						}
+					}
+					first := false
+					a.evaluator.transitionObserver = func(_ *Position, e *workerEvaluator) {
+						if e.evaluationDepth() == 1 && !first {
+							first = true
+							if window[0] != 1999 && ttMoveLegal(probe, tt) && (a.MainMoveLists != 0 || a.MainMoveScores != 0 || a.TTFirstAttempts != 1) {
+								t.Fatal("generated/scored before first TT attempt")
+							}
+						}
+					}
+					before := snapshotPVPosition(p)
+					got := alphaBetaPV(p, 2, 1, window[0], window[1], window[0] < 999, false, false, a)
+					want := ttReferenceAlphaBetaPV(q, 2, 1, window[0], window[1], window[0] < 999, false, false, b)
+					if got != want || !reflect.DeepEqual(ttDecisionState(a), ttDecisionState(b)) {
+						t.Fatalf("score/counters differ got=%d want=%d\n%v\n%v", got, want, ttDecisionState(a), ttDecisionState(b))
+					}
+					if !reflect.DeepEqual(a.history, b.history) {
+						t.Fatal("history/counter/killer/correction state differs")
+					}
+					if !reflect.DeepEqual(before, snapshotPVPosition(p)) {
+						t.Fatal("search changed parent position")
+					}
+					if window[0] != 1999 && ttMoveLegal(probe, tt) && !first {
+						t.Fatal("positive TT attempt never observed")
+					}
+				})
+				cases++
+			}
+		}
+	}
+	t.Logf("seed=1104 pinned search comparisons=%d; all scalar/array counters and full history match", cases)
+}
+
+func TestTTFirstCutoff(t *testing.T) {
+	p, a := newProbcutContractState(t, 1)
+	q, b := newProbcutContractState(t, 1)
+	tt := adapterLegalMove(t, p, "a1a7")
+	for _, info := range []*SearchInfo{a, b} {
+		info.tt.Set(p.Hash(), tt, 0, -1, UpperBound, false)
+	}
+	got := alphaBetaPV(p, 1, 0, -1, 0, true, false, false, a)
+	want := ttReferenceAlphaBetaPV(q, 1, 0, -1, 0, true, false, false, b)
+	if got != want || !reflect.DeepEqual(ttDecisionState(a), ttDecisionState(b)) || !reflect.DeepEqual(a.history, b.history) {
+		t.Fatal("TT cutoff decisions/history changed")
+	}
+	if a.CutByTT != 1 || a.TTFirstAttempts != 1 || a.MainMoveLists != 0 || a.MainMoveScores != 0 {
+		t.Fatalf("TT cutoff generated/scored main list: attempts=%d lists=%d scores=%d cut=%d", a.TTFirstAttempts, a.MainMoveLists, a.MainMoveScores, a.CutByTT)
+	}
+	t.Log("TT cutoff: main lists=0 main scores=0; decision counters/history match pinned search")
+}
