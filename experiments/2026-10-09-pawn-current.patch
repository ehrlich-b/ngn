diff --git a/engine/pawn_quiet_history.go b/engine/pawn_quiet_history.go
new file mode 100644
index 0000000..0e04d5a
--- /dev/null
+++ b/engine/pawn_quiet_history.go
@@ -0,0 +1,45 @@
+package engine
+
+const pawnQuietBuckets = 512
+
+func pawnQuietEligible(move Move) bool {
+	return h1QuietMove(move) && !move.IsEnPassant() && !move.IsCastle()
+}
+
+// The existing board-only pawn hash supplies context, without sharing learned
+// entries with evaluation correction. Colored moving pieces distinguish sides.
+func pawnQuietIndex(pos *Position) int {
+	return pawnCorrectionIndex(pos.Board.pieces[WhitePawn], pos.Board.pieces[BlackPawn]) & (pawnQuietBuckets - 1)
+}
+
+// Update only a completed quiet winner and the completed quiets before it.
+// The parent position must be restored before this call: a pawn move's result
+// is credited to the structure in which it was chosen, not its child structure.
+func (h *workerHistory) updatePawnQuiets(pos *Position, searched []Move, best Move, depth, originalAlpha, score int) {
+	if score <= originalAlpha || !pawnQuietEligible(best) {
+		return
+	}
+	winner := -1
+	for i, move := range searched {
+		if move == best {
+			winner = i
+			break
+		}
+	}
+	if winner < 0 {
+		return
+	}
+	index := pawnQuietIndex(pos)
+	rate := h1HistoryRate(depth)
+	update := func(move Move, target int) {
+		if !pawnQuietEligible(move) {
+			return
+		}
+		entry := &h.pawnQuietHistory[index][move.MovingPiece()][move.Destination()]
+		*entry = int16(h1HistoryResponse(int(*entry), target, rate))
+	}
+	update(best, historyMax)
+	for _, move := range searched[:winner] {
+		update(move, -historyMax)
+	}
+}
diff --git a/engine/pawn_quiet_history_test.go b/engine/pawn_quiet_history_test.go
new file mode 100644
index 0000000..d1e38ae
--- /dev/null
+++ b/engine/pawn_quiet_history_test.go
@@ -0,0 +1,89 @@
+package engine
+
+import "testing"
+
+func pawnQuietFixture(t *testing.T) (*Position, []Move) {
+	t.Helper()
+	pos, err := ParseFEN("4k3/4p3/8/8/8/8/4P3/1N2K1N1 w - - 0 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pos, []Move{
+		NewMove(B1, C3, WhiteKnight, NoPiece, NoType, 0),
+		NewMove(B1, A3, WhiteKnight, NoPiece, NoType, 0),
+		NewMove(G1, F3, WhiteKnight, NoPiece, NoType, 0),
+	}
+}
+
+func TestPawnQuietCompletedExamples(t *testing.T) {
+	pos, moves := pawnQuietFixture(t)
+	h := &workerHistory{}
+	h.updatePawnQuiets(pos, moves, moves[1], 8, 0, 10)
+	row := &h.pawnQuietHistory[pawnQuietIndex(pos)][WhiteKnight]
+	if row[C3] >= 0 || row[A3] <= 0 || row[F3] != 0 {
+		t.Fatalf("only winner and prior completed quiet should learn: %v", row)
+	}
+	if h.GetHistoryScore(moves[1], EmptyMove, EmptyMove) != 0 {
+		t.Fatal("pawn ordering history leaked into pruning/LMR history")
+	}
+	for i := 0; i < 1000; i++ {
+		h.updatePawnQuiets(pos, moves, moves[1], 100, 0, 10)
+	}
+	if row[A3] > historyMax || row[C3] < -historyMax {
+		t.Fatal("history escaped its bounds")
+	}
+}
+
+func TestPawnQuietStoppedRootDoesNotLearn(t *testing.T) {
+	searcher, err := NewSearchEngineWithHash(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	searcher.NewGame()
+	searcher.SetMaxNodes(1)
+	info := searcher.Search(controlTestPosition(t), 1)
+	if !info.Stopped {
+		t.Fatal("node-limited root did not stop")
+	}
+	if searcher.worker.history.pawnQuietHistory != [pawnQuietBuckets][13][64]int16{} {
+		t.Fatal("interrupted root trained pawn history")
+	}
+}
+
+func TestPawnQuietNoUnprovedSignal(t *testing.T) {
+	pos, moves := pawnQuietFixture(t)
+	h := &workerHistory{}
+	h.updatePawnQuiets(pos, moves, moves[1], 8, 10, 10)
+	h.updatePawnQuiets(pos, moves[:1], moves[1], 8, 0, 10)
+	for _, special := range []Move{
+		NewMove(E2, D3, WhitePawn, BlackKnight, NoType, Capture),
+		NewMove(E5, D6, WhitePawn, NoPiece, NoType, EnPassant),
+		NewMove(E7, E8, WhitePawn, NoPiece, Queen, 0),
+		NewMove(E1, G1, WhiteKing, NoPiece, NoType, KingSideCastle),
+	} {
+		h.updatePawnQuiets(pos, append(moves[:1:1], special), special, 8, 0, 10)
+	}
+	if h.pawnQuietHistory != [pawnQuietBuckets][13][64]int16{} {
+		t.Fatal("fail-low, unsearched winner, or special move trained pawn history")
+	}
+}
+
+func TestPawnQuietContextOwnershipAndReset(t *testing.T) {
+	pos, moves := pawnQuietFixture(t)
+	other, err := ParseFEN("4k3/4p3/8/8/8/4P3/8/1N2K1N1 w - - 0 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pawnQuietIndex(pos) == pawnQuietIndex(other) {
+		t.Fatal("fixture contexts collide")
+	}
+	first, second := &workerHistory{}, &workerHistory{}
+	first.updatePawnQuiets(pos, moves, moves[1], 8, 0, 10)
+	if first.pawnQuietHistory[pawnQuietIndex(other)][WhiteKnight][A3] != 0 || second.pawnQuietHistory != [pawnQuietBuckets][13][64]int16{} {
+		t.Fatal("context or worker ownership leaked")
+	}
+	first.ClearHistoryTable()
+	if first.pawnQuietHistory != [pawnQuietBuckets][13][64]int16{} {
+		t.Fatal("new game did not clear pawn history")
+	}
+}
diff --git a/engine/pawn_quiet_ordering_test.go b/engine/pawn_quiet_ordering_test.go
new file mode 100644
index 0000000..94e76f2
--- /dev/null
+++ b/engine/pawn_quiet_ordering_test.go
@@ -0,0 +1,34 @@
+package engine
+
+import "testing"
+
+// Uses only the baseline API: without a pawn-context producer/consumer, both
+// positions necessarily receive the same quiet ordering score after learning.
+func TestPawnQuietOrderingConsumesCompletedRoot(t *testing.T) {
+	searcher, err := NewSearchEngineWithHash(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pos, err := ParseFEN("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := ParseFEN("rnbqkbnr/pppppppp/8/8/8/P7/1PPPPPPP/RNBQKBNR w KQkq - 0 1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	searcher.NewGame()
+	info := searcher.Search(pos, 1)
+	if info.Stopped || info.BestMove == EmptyMove {
+		t.Fatal("root did not complete")
+	}
+	moves := []Move{info.BestMove}
+	var out [1]Move
+	var trained, different [1]int
+	h := searcher.worker.history
+	h.scoreMovesIntoBuffer(moves, 0, EmptyMove, EmptyMove, EmptyMove, false, out[:], trained[:], pos, false)
+	h.scoreMovesIntoBuffer(moves, 0, EmptyMove, EmptyMove, EmptyMove, false, out[:], different[:], other, false)
+	if trained[0] <= different[0] {
+		t.Fatalf("completed root did not train its pawn context: trained=%d other=%d", trained[0], different[0])
+	}
+}
