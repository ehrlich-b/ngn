@@ -0,0 +1,258 @@
+package engine
+
+import (
+	"reflect"
+	"testing"
+)
+
+func continuationFixture(t *testing.T, stm Color) (*Position, *SearchInfo, int) {
+	t.Helper()
+	fen := "3k4/8/8/8/8/4P3/8/4K3 w - - 0 2"
+	older := NewMove(E2, E3, WhitePawn, NoPiece, NoType, 0)
+	newer := NewMove(E8, D8, BlackKing, NoPiece, NoType, 0)
+	if stm == Black {
+		fen = "4k3/8/4p3/8/8/8/8/3K4 b - - 0 2"
+		older = NewMove(E7, E6, BlackPawn, NoPiece, NoType, 0)
+		newer = NewMove(E1, D1, WhiteKing, NoPiece, NoType, 0)
+	}
+	pos := n3cPosition(t, fen)
+	info := newQSearchInfo()
+	info.history = &workerHistory{}
+	info.control = &SearchControl{}
+	info.tt = NewCache(1)
+	info.MoveStack[0], info.MoveStack[1] = older, newer
+	idx, valid := continuationCorrectionContext(info, 2, stm)
+	if !valid {
+		t.Fatal("fixture has no real-move context")
+	}
+	return pos, info, idx
+}
+
+func TestContinuationQuietHorizonWitness(t *testing.T) {
+	for _, stm := range []Color{White, Black} {
+		for _, sign := range []int16{-1, 1} {
+			pos, info, idx := continuationFixture(t, stm)
+			pawnIdx := pawnCorrectionIndex(pos.Board.pieces[WhitePawn], pos.Board.pieces[BlackPawn])
+			info.history.pawnCorrectionHistory[stm][pawnIdx] = corrHistLimit / 2
+			raw := info.history.correctedStandPat(pos, info.evaluator)
+			info.history.continuationCorrectionHistory[stm][idx] = sign * corrHistLimit
+			before := snapshotPVPosition(pos)
+			history := info.history.continuationCorrectionHistory
+			got := quiescence(pos, -INFINITY, INFINITY, 2, info)
+			want := raw + int(sign)*48
+			if got != want {
+				t.Fatalf("quiet horizon ignored temporal residual: stm=%v sign=%d got=%d want=%d", stm, sign, got, want)
+			}
+			if !reflect.DeepEqual(snapshotPVPosition(pos), before) || history != info.history.continuationCorrectionHistory {
+				t.Fatal("quiet qsearch changed position or learned residuals")
+			}
+		}
+	}
+}
+
+func TestContinuationContextNullRootAndPromotion(t *testing.T) {
+	_, info, idx := continuationFixture(t, White)
+	for _, ply := range []int{-1, 0, 1, MaximumDepth + 1} {
+		if _, valid := continuationCorrectionContext(info, ply, White); valid {
+			t.Fatalf("context valid at ply %d", ply)
+		}
+	}
+	if _, valid := continuationCorrectionContext(info, 2, Black); valid {
+		t.Fatal("context accepted reversed colors")
+	}
+	for _, slot := range []int{0, 1} {
+		saved := info.MoveStack[slot]
+		info.MoveStack[slot] = EmptyMove
+		if _, valid := continuationCorrectionContext(info, 2, White); valid {
+			t.Fatal("null ancestry retained temporal context")
+		}
+		info.MoveStack[slot] = saved
+	}
+	// Source and capture flags are intentionally outside the context.
+	info.MoveStack[0] = NewMove(D2, E3, WhitePawn, BlackPawn, NoType, Capture)
+	if changed, valid := continuationCorrectionContext(info, 2, White); !valid || changed != idx {
+		t.Fatal("source/capture flag changed piece-to context")
+	}
+	promotion := NewMove(A7, A8, WhitePawn, NoPiece, Queen, 0)
+	queenMove := NewMove(B8, A8, WhiteQueen, NoPiece, NoType, 0)
+	promoted, valid := continuationMoveCode(promotion)
+	queen, _ := continuationMoveCode(queenMove)
+	if !valid || promoted != queen {
+		t.Fatal("promotion context did not name the resulting queen")
+	}
+	under, _ := continuationMoveCode(NewMove(A7, A8, WhitePawn, NoPiece, Knight, 0))
+	if under == queen {
+		t.Fatal("underpromotion aliased queen before hashing")
+	}
+	seen := map[int]bool{}
+	for to := Square(0); to < 64; to++ {
+		info.MoveStack[0] = NewMove(E2, to, WhitePawn, NoPiece, NoType, 0)
+		key, valid := continuationCorrectionContext(info, 2, White)
+		if !valid || key < 0 || key >= corrHistSize {
+			t.Fatalf("invalid index %d", key)
+		}
+		seen[key] = true
+	}
+	if len(seen) < 60 {
+		t.Fatalf("destination keys collapse: %d/64 distinct", len(seen))
+	}
+}
+
+func TestContinuationLearningBoundsAndGates(t *testing.T) {
+	quiet := NewMove(E3, E4, WhitePawn, NoPiece, NoType, 0)
+	capture := NewMove(E3, D4, WhitePawn, BlackPawn, NoType, Capture)
+	promotion := NewMove(A7, A8, WhitePawn, NoPiece, Queen, 0)
+	for _, tc := range []struct {
+		name                                   string
+		static, score, beta, depth             int
+		move                                   Move
+		valid, check, singular, stopped, learn bool
+	}{
+		{"quiet-fail-high", 0, 200, 50, 8, quiet, true, false, false, false, true},
+		{"upper-below-static", 0, -200, 50, 8, EmptyMove, true, false, false, false, true},
+		{"bound-above-static-without-move", 0, 200, 50, 8, EmptyMove, true, false, false, false, false},
+		{"lower-below-static", 200, 100, 50, 8, quiet, true, false, false, false, false},
+		{"capture", 0, 200, 50, 8, capture, true, false, false, false, false},
+		{"promotion", 0, 200, 50, 8, promotion, true, false, false, false, false},
+		{"check", 0, 200, 50, 8, quiet, true, true, false, false, false},
+		{"singular", 0, 200, 50, 8, quiet, true, false, true, false, false},
+		{"stopped", 0, 200, 50, 8, quiet, true, false, false, true, false},
+		{"null", 0, 200, 50, 8, quiet, false, false, false, false, false},
+		{"zero-depth", 0, 200, 50, 0, quiet, true, false, false, false, false},
+		{"mate", 0, MATE_IN_MAX, 50, 8, quiet, true, false, false, false, false},
+		{"negative-mate", 0, -MATE_IN_MAX, 50, 8, quiet, true, false, false, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := &workerHistory{}
+			h.maybeUpdateContinuationCorrection(White, 7, tc.valid, tc.static, tc.score, tc.beta, tc.depth, tc.move, tc.check, tc.singular, tc.stopped)
+			if (h.continuationCorrectionHistory[White][7] != 0) != tc.learn {
+				t.Fatalf("learned=%d want learning=%v", h.continuationCorrectionHistory[White][7], tc.learn)
+			}
+		})
+	}
+	h := &workerHistory{}
+	for _, sign := range []int{-1, 1} {
+		for n := 0; n < 200; n++ {
+			h.maybeUpdateContinuationCorrection(White, 9, true, 0, sign*200, 300, 8, quiet, false, false, false)
+			entry := int(h.continuationCorrectionHistory[White][9])
+			if abs(entry) > corrHistLimit {
+				t.Fatalf("entry outside clamp: %d", entry)
+			}
+		}
+		if value := h.continuationCorrectionValue(White, 9); value*sign <= 0 || abs(value) > 48 {
+			t.Fatalf("wrong signed applied correction: %d", value)
+		}
+	}
+	if h.continuationCorrectionHistory[Black][9] != 0 || (&workerHistory{}).continuationCorrectionHistory[White][9] != 0 {
+		t.Fatal("residual leaked across side or worker")
+	}
+	h.ClearHistoryTable()
+	if h.continuationCorrectionHistory != ([2][corrHistSize]int16{}) {
+		t.Fatal("new-game reset retained residuals")
+	}
+}
+
+func TestContinuationMainStaticAndStoppedParent(t *testing.T) {
+	for _, stop := range []bool{false, true} {
+		pos, info := newProbcutContractStateForFEN(t, "3k4/8/8/8/8/4P3/8/4K3 w - - 0 2", 1)
+		_, seed, idx := continuationFixture(t, White)
+		info.MoveStack = seed.MoveStack
+		info.history.continuationCorrectionHistory[White][idx] = corrHistLimit
+		before := snapshotPVPosition(pos)
+		old := info.history.continuationCorrectionHistory
+		if stop {
+			info.maxNodes = 1 // parent completes its static eval; first child stops
+		}
+		score := alphaBetaPV(pos, 1, 2, -INFINITY, INFINITY, true, false, false, info)
+		if info.StaticEvalStack[2] != 48 {
+			t.Fatalf("main static ignored temporal residual: got %d", info.StaticEvalStack[2])
+		}
+		if !reflect.DeepEqual(before, snapshotPVPosition(pos)) || info.FrameDepth != 0 || info.RepStackLen != 0 {
+			t.Fatal("main search did not restore root/frame/path")
+		}
+		if stop && (score != stoppedSearchScore || !info.Stopped || old != info.history.continuationCorrectionHistory) {
+			t.Fatal("stopped parent learned or failed to unwind")
+		}
+	}
+}
+
+func TestContinuationQsearchRecordsEvasionsAndCaptures(t *testing.T) {
+	for _, fen := range []string{
+		"4k3/p7/8/8/8/8/8/R3K3 w - - 0 1",   // capture a1a7
+		"4k3/p7/8/8/8/8/4r2P/4K3 w - - 0 1", // checked king captures e2; pawns prevent terminal material draw
+	} {
+		pos, info := newProbcutContractStateForFEN(t, fen, 1)
+		stale := NewMove(H2, H3, WhitePawn, NoPiece, NoType, 0)
+		info.MoveStack[0] = stale
+		before := snapshotPVPosition(pos)
+		seen := false
+		info.evaluator.staticOracle = func(observed *Position) int {
+			if info.evaluator.evaluationDepth() == 1 {
+				seen = true
+				move := info.MoveStack[0]
+				if move == stale || move.MovingPiece().Color() != White || observed.Board.pieces[move.MovingPiece()]&(uint64(1)<<move.Destination()) == 0 {
+					t.Fatal("qsearch child read stale continuation ancestry")
+				}
+			}
+			return 0
+		}
+		quiescence(pos, -INFINITY, INFINITY, 0, info)
+		if !seen || !reflect.DeepEqual(before, snapshotPVPosition(pos)) {
+			t.Fatal("qsearch fixture missed child or changed root")
+		}
+	}
+}
+
+func TestContinuationTerminalAndCheckPrecedence(t *testing.T) {
+	pos, info, idx := continuationFixture(t, White)
+	info.history.continuationCorrectionHistory[White][idx] = corrHistLimit
+	pos.HalfMoveClock = 100
+	if got := quiescence(pos, -INFINITY, INFINITY, 2, info); got != 0 {
+		t.Fatalf("temporal residual changed a terminal draw: %d", got)
+	}
+	pos, info, idx = continuationFixture(t, White)
+	info.history.continuationCorrectionHistory[White][idx] = corrHistLimit
+	info.control.RequestStop()
+	old := info.history.continuationCorrectionHistory
+	if got := quiescence(pos, -INFINITY, INFINITY, 2, info); got != stoppedSearchScore || old != info.history.continuationCorrectionHistory {
+		t.Fatal("stop failed to precede temporal evaluation")
+	}
+	const checked = "4k3/p7/8/8/8/8/4r2P/4K3 w - - 0 1"
+	poisoned, poisonedInfo := newProbcutContractStateForFEN(t, checked, 1)
+	_, seed, idx := continuationFixture(t, White)
+	poisonedInfo.MoveStack = seed.MoveStack
+	poisonedInfo.history.continuationCorrectionHistory[White][idx] = corrHistLimit
+	rootHash, sawChild := poisoned.Hash(), false
+	poisonedInfo.evaluator.staticOracle = func(observed *Position) int {
+		if observed.Hash() == rootHash {
+			t.Fatal("checked node evaluated a temporal stand-pat")
+		}
+		sawChild = true
+		return 0
+	}
+	quiescence(poisoned, -INFINITY, INFINITY, 2, poisonedInfo)
+	if !sawChild {
+		t.Fatal("checked fixture did not search evasions")
+	}
+}
+
+func TestContinuationLearnedByRealSearch(t *testing.T) {
+	searcher, err := NewSearchEngineWithHash(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pos := n3cPosition(t, "r1bqkb1r/pppp1ppp/2n2n2/4p3/2B1P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 4 4")
+	before := snapshotPVPosition(pos)
+	info := searcher.Search(pos, 5)
+	nonzero := 0
+	for _, side := range searcher.worker.history.continuationCorrectionHistory {
+		for _, entry := range side {
+			if entry != 0 {
+				nonzero++
+			}
+		}
+	}
+	if info.Stopped || info.BestMove == EmptyMove || nonzero == 0 || !reflect.DeepEqual(before, snapshotPVPosition(pos)) {
+		t.Fatalf("real search failed to learn cleanly: stopped=%v move=%s slots=%d", info.Stopped, info.BestMove.ToString(), nonzero)
+	}
+}
