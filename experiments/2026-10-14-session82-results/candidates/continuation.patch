index 0000000..7b7aafe
--- /dev/null
+++ b/engine/continuation_correction.go
@@ -0,0 +1,76 @@
+package engine
+
+// A continuation residual describes the last two real moves on this search
+// path, rather than a board structure. Source squares and capture flags are
+// deliberately absent: the context is the resulting piece and its destination.
+// Promotions use the promoted piece. No played-game predecessor is imported at
+// the root, and a null move breaks the two-move context.
+func continuationMoveCode(move Move) (uint32, bool) {
+	if move == EmptyMove || move.MovingPiece() <= NoPiece || move.MovingPiece() > BlackKing {
+		return 0, false
+	}
+	piece := move.MovingPiece()
+	if promotion := move.PromoType(); promotion != NoType {
+		if promotion < Knight || promotion > Queen {
+			return 0, false
+		}
+		piece = GetPiece(promotion, piece.Color())
+	}
+	return uint32(piece)*64 + uint32(move.Destination()), true
+}
+
+func continuationCorrectionContext(info *SearchInfo, ply int, stm Color) (int, bool) {
+	if ply < 2 || ply > len(info.MoveStack) || (stm != White && stm != Black) {
+		return 0, false
+	}
+	older, newer := info.MoveStack[ply-2], info.MoveStack[ply-1]
+	a, validA := continuationMoveCode(older)
+	b, validB := continuationMoveCode(newer)
+	if !validA || !validB || older.MovingPiece().Color() != stm || newer.MovingPiece().Color() != stm.Other() {
+		return 0, false
+	}
+	// Fold the ordered ten-bit piece/to codes into the existing 14-bit table
+	// budget. Multiplication spreads nearby destinations across the table.
+	key := a<<10 | b
+	key ^= key >> 11
+	key *= 0x9e3779b1
+	return int((key ^ key>>16) & corrHistMask), true
+}
+
+func (h *workerHistory) continuationCorrectionValue(stm Color, idx int) int {
+	return int(h.continuationCorrectionHistory[stm][idx]) * 3 / 64
+}
+
+func (h *workerHistory) continuationStandPat(pos *Position, info *SearchInfo, ply int) int {
+	value := h.correctedStandPat(pos, info.evaluator)
+	if idx, valid := continuationCorrectionContext(info, ply, pos.Turn()); valid {
+		value += h.continuationCorrectionValue(pos.Turn(), idx)
+	}
+	return value
+}
+
+// Learn only a completed main-search residual, measured against the total
+// corrected static before TT refinement. Qsearch consumes this term but never
+// trains it. Reuse NGN's bounded depth-weighted update and conservative bound
+// direction rule; capture, promotion, mate and move-excluded results are skipped.
+func (h *workerHistory) maybeUpdateContinuationCorrection(stm Color, idx int, valid bool,
+	staticEval, bestScore, beta, depth int, bestMove Move, inCheck, inSingular, stopped bool) {
+	if !valid || stopped || inCheck || inSingular || depth <= 0 ||
+		abs(staticEval) >= MATE_IN_MAX || abs(bestScore) >= MATE_IN_MAX ||
+		(bestMove != EmptyMove && (bestMove.IsCapture() || bestMove.PromoType() != NoType)) {
+		return
+	}
+	if !((bestScore < staticEval && bestScore < beta) || (bestScore > staticEval && bestMove != EmptyMove)) {
+		return
+	}
+	bonus := (bestScore - staticEval) * depth / 8
+	if bonus > corrHistLimit/4 {
+		bonus = corrHistLimit / 4
+	} else if bonus < -corrHistLimit/4 {
+		bonus = -corrHistLimit / 4
+	}
+	entry := &h.continuationCorrectionHistory[stm][idx]
+	value := int(*entry)
+	value += bonus - value*abs(bonus)/corrHistLimit
+	*entry = int16(value)
+}
diff --git a/engine/continuation_correction_test.go b/engine/continuation_correction_test.go
