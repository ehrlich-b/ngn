@@ -0,0 +1,46 @@
+package main
+
+import (
+	"sync/atomic"
+	"testing"
+)
+
+func TestGameJobsPreservesAllPerturbationsWithTwoEnginePairs(t *testing.T) {
+	var visits [6]atomic.Int32
+	var active [2]atomic.Int32
+	started := make(chan struct{}, 2)
+	release := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		runGameJobs(6, 2, func(job, slot int) {
+			if slot < 0 || slot >= 2 || job < 0 || job >= 6 {
+				t.Errorf("invalid job/worker: %d/%d", job, slot)
+				return
+			}
+			if active[slot].Add(1) != 1 {
+				t.Errorf("engine pair %d used concurrently", slot)
+			}
+			if job < 2 {
+				started <- struct{}{}
+				<-release
+			}
+			visits[job].Add(1)
+			active[slot].Add(-1)
+		})
+		close(done)
+	}()
+	<-started
+	<-started
+	select {
+	case <-done:
+		t.Fatal("returned before the game pairs finished")
+	default:
+	}
+	close(release)
+	<-done
+	for job := range visits {
+		if got := visits[job].Load(); got != 1 {
+			t.Errorf("perturbation %d completed %d times, want one", job, got)
+		}
+	}
+}
