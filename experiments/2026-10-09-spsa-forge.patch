+++ b/cmd/spsa/game_jobs.go
@@ -0,0 +1,19 @@
+package main
+
+import "sync"
+
+// Each worker owns one engine pair. A six-perturbation update can therefore
+// finish in three waves on two workers without changing its gradient or RNG.
+func runGameJobs(jobs, slots int, play func(job, slot int)) {
+	var wg sync.WaitGroup
+	for slot := 0; slot < slots; slot++ {
+		wg.Add(1)
+		go func(slot int) {
+			defer wg.Done()
+			for job := slot; job < jobs; job += slots {
+				play(job, slot)
+			}
+		}(slot)
+	}
+	wg.Wait()
+}
