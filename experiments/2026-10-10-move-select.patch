+package engine
+
+import (
+	"math/rand"
+	"slices"
+	"testing"
+)
+
+func TestMoveSelectScalarIdentity(t *testing.T) {
+	rng := rand.New(rand.NewSource(20261010))
+	for n := 1; n <= 256; n++ {
+		for pattern := 0; pattern < 8; pattern++ {
+			moves := make([]Move, n)
+			scores := make([]int, n)
+			for j := range moves {
+				moves[j] = Move(j + 1)
+				switch pattern {
+				case 0:
+					scores[j] = 7
+				case 1:
+					scores[j] = j
+				case 2:
+					scores[j] = -j
+				case 3:
+					scores[j] = j % 4
+				case 4:
+					scores[j] = (j / 4) % 4
+				case 5:
+					scores[j] = rng.Intn(3) - 1
+				case 6:
+					scores[j] = rng.Intn(1<<31) - (1 << 30)
+				default:
+					scores[j] = -1 << 30
+					if j%7 == 0 {
+						scores[j] = 100000
+					}
+				}
+			}
+			wantMoves, wantScores := slices.Clone(moves), slices.Clone(scores)
+			for i := 0; i < n; i++ {
+				best := i
+				for j := i + 1; j < n; j++ {
+					if wantScores[j] > wantScores[best] {
+						best = j
+					}
+				}
+				wantMoves[i], wantMoves[best] = wantMoves[best], wantMoves[i]
+				wantScores[i], wantScores[best] = wantScores[best], wantScores[i]
+				selectNextMove(moves, scores, n, i)
+				if !slices.Equal(moves, wantMoves) || !slices.Equal(scores, wantScores) {
+					t.Fatalf("n=%d pattern=%d step=%d: selection differs from scalar order", n, pattern, i)
+				}
+			}
+		}
+	}
+}
