diff --git a/engine/history_storage_test.go b/engine/history_storage_test.go
new file mode 100644
index 0000000..5f097bb
--- /dev/null
+++ b/engine/history_storage_test.go
@@ -0,0 +1,41 @@
+package engine
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestCompactHistoryStorageBounds(t *testing.T) {
+	if historyMax > 32767 || historyBonusCap > historyMax || h1HistoryRateCap > h1HistoryDivisor {
+		t.Fatal("history learning no longer proves int16 storage safe")
+	}
+	var h workerHistory
+	const bytesPerTable = 13 * 64 * 13 * 64 * 2
+	if unsafe.Sizeof(h.continuationHistory) != bytesPerTable || unsafe.Sizeof(h.followupHistory) != bytesPerTable {
+		t.Fatal("continuation tables no longer use compact int16 storage")
+	}
+	// Exercise every reachable stored value. Compare narrow storage with the
+	// original wide update, including saturated bonuses and truncation at zero.
+	for value := -historyMax; value <= historyMax; value++ {
+		for _, bonus := range []int{-1000000, -historyBonusCap, -1, 0, 1, historyBonusCap, 1000000} {
+			wide, narrow := value, int16(value)
+			gravityUpdate(&wide, bonus)
+			gravityUpdate(&narrow, bonus)
+			if wide < -historyMax || wide > historyMax || int(narrow) != wide {
+				t.Fatalf("gravity entry=%d bonus=%d: wide=%d narrow=%d", value, bonus, wide, narrow)
+			}
+		}
+		// Policy 11 is the live quiet-history producer. Its response uses int64
+		// intermediate arithmetic and truncates toward zero, including negatives.
+		for rate := 0; rate <= h1HistoryRateCap; rate++ {
+			for _, target := range []int{-historyMax, historyMax} {
+				want := h1HistoryResponse(value, target, rate)
+				narrow := int16(value)
+				h1HistoryResponseUpdate(&narrow, target, rate)
+				if want < -historyMax || want > historyMax || int(narrow) != want {
+					t.Fatalf("policy11 entry=%d target=%d rate=%d: wide=%d narrow=%d", value, target, rate, want, narrow)
+				}
+			}
+		}
+	}
+}
