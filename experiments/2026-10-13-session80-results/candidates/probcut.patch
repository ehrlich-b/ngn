+package engine
+
+import "testing"
+
+func TestProbcutNegativeTTBound(t *testing.T) {
+	for _, side := range []struct{ name, fen, capture string }{
+		{"white", probcutContractFEN, "a1a7"},
+		{"black", "r3k3/8/8/8/8/8/P7/4K3 b - - 0 1", "a8a2"},
+	} {
+		for _, c := range []struct {
+			name      string
+			bound     NodeType
+			depth     int8
+			score     int16
+			wantPrune uint64
+		}{
+			{"upper below threshold", UpperBound, 2, -1, 0},
+			{"exact below threshold", Exact, 2, -1, 0},
+			{"lower below threshold", LowerBound, 2, -1, 1},
+			{"shallow upper", UpperBound, 1, -1, 1},
+			{"upper at threshold", UpperBound, 2, 0, 1},
+			{"exact above threshold", Exact, 2, 1, 1},
+		} {
+			t.Run(side.name+"/"+c.name, func(t *testing.T) {
+				pos, info := newProbcutContractStateForFEN(t, side.fen, 5)
+				before := snapshotPVPosition(pos)
+				capture := adapterLegalMove(t, pos, side.capture)
+				child := probcutChild(t, pos, capture)
+				// Ordinary root cutoffs require depth5; this entry is deliberately
+				// too shallow. The child makes the existing ProbCut succeed exactly.
+				info.tt.Set(pos.Hash(), capture, c.score, c.depth, c.bound, false)
+				info.tt.Set(child.Hash(), EmptyMove, 0, 1, Exact, false)
+				got := alphaBetaPV(pos, 5, 0, -201, -200, false, false, false, info)
+				if info.Stopped || got < -200 || info.ProbcutPrunes != c.wantPrune {
+					t.Fatalf("score=%d stopped=%v ProbcutPrunes=%d want=%d", got, info.Stopped, info.ProbcutPrunes, c.wantPrune)
+				}
+				requireProbcutSearchUnwound(t, pos, before, info, EmptyMove, 0, 0)
+			})
+		}
+	}
+}
