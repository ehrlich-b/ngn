+// Natural serialized rows also support a contiguous-input AVX2 dot. Each
+// partial sum and its reduction fit int32 under the format's weight bound.
+func ngnn4LinearRowsGo(dst []int32, input []uint8, weights []int8) {
+	for j := range dst {
+		var sum int32
+		for i, x := range input {
+			sum += int32(x) * int32(weights[j*len(input)+i])
+		}
+		dst[j] = sum
+	}
+}
