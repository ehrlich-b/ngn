+// completedRootChoice retains only exact, finished comparisons from this
+// aspiration attempt. The previous completed depth's move must finish first
+// inside the window before a later in-window improvement can replace it.
+type completedRootChoice struct {
+	previous Move
+	alpha    int
+	beta     int
+	ready    bool
+	move     Move
+	score    int
+}
+
+func (choice *completedRootChoice) record(move Move, score int, first bool) {
+	if first {
+		choice.ready = move == choice.previous && move != EmptyMove && score > choice.alpha && score < choice.beta
+		choice.score = score
+		return
+	}
+	if choice.ready && score > choice.score && score < choice.beta {
+		choice.move = move
+		choice.score = score
+	}
+}
+
+func (choice *completedRootChoice) retainOnClockStop(info *SearchInfo) {
+	if choice.move == EmptyMove || !info.Stopped || info.TimeManager == nil ||
+		info.TimeManager.timeControl != Tournament || !info.TimeManager.shouldStop ||
+		info.control.StopRequested() {
+		return
+	}
+	// Depth and completed-iteration accounting remain at the last whole depth.
+	// No partial root score is stored in the TT or fed to history learning.
+	info.BestMove = choice.move
+	info.BestScore = choice.score
+}
