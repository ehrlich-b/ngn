+package engine
+
+import (
+	"slices"
+	"testing"
+	"time"
+)
+
+func partialRootMoves(t *testing.T) (Move, Move, Move) {
+	t.Helper()
+	p := controlTestPosition(t)
+	moves := GenerateMoves(p)
+	if len(moves) < 3 {
+		t.Fatal("opening fixture has fewer than three moves")
+	}
+	return moves[0], moves[1], moves[2]
+}
+
+func TestPartialRootRetainsCompletedImprovementOnly(t *testing.T) {
+	old, better, worse := partialRootMoves(t)
+	choice := completedRootChoice{previous: old, alpha: -20, beta: 20}
+	choice.record(old, -5, true)
+	choice.record(better, 8, false)
+	choice.record(worse, 2, false)
+	tm := NewTimeManager()
+	tm.timeControl, tm.shouldStop = Tournament, true
+	info := &SearchInfo{BestMove: old, BestScore: 15, Depth: 4, RootDepth: 5,
+		Stopped: true, TimeManager: tm, control: &SearchControl{}, AspFailHighs: 2}
+	choice.retainOnClockStop(info)
+	if info.BestMove != better || info.BestScore != 8 || info.Depth != 4 || info.RootDepth != 5 || info.AspFailHighs != 2 {
+		t.Fatalf("finished improvement or completed-depth accounting lost: %+v", info)
+	}
+}
+
+func TestPartialRootRejectsUnprovedComparisons(t *testing.T) {
+	old, better, other := partialRootMoves(t)
+	for _, test := range []struct {
+		name                  string
+		first                 Move
+		previous              Move
+		firstScore, nextScore int
+	}{
+		{"incumbent fail low", old, old, -20, 8},
+		{"incumbent fail high", old, old, 20, 21},
+		{"incumbent not first", other, old, -5, 8},
+		{"no completed depth", old, EmptyMove, -5, 8},
+		{"equal alternative", old, old, 8, 8},
+		{"worse alternative", old, old, 8, 7},
+		{"alternative fail high", old, old, -5, 20},
+		{"alternative upper bound", old, old, -5, -20},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			choice := completedRootChoice{previous: test.previous, alpha: -20, beta: 20}
+			choice.record(test.first, test.firstScore, true)
+			choice.record(better, test.nextScore, false)
+			if choice.move != EmptyMove {
+				t.Fatalf("unproved comparison retained %v", choice.move)
+			}
+		})
+	}
+}
+
+func TestPartialRootPreservesOtherStopPolicies(t *testing.T) {
+	old, better, _ := partialRootMoves(t)
+	choice := completedRootChoice{previous: old, alpha: -20, beta: 20}
+	choice.record(old, -5, true)
+	choice.record(better, 8, false)
+	for _, test := range []struct {
+		name                            string
+		control                         TimeControl
+		stopped, clockStopped, external bool
+	}{
+		{"whole iteration", Tournament, false, false, false},
+		{"external stop", Tournament, true, false, true},
+		{"coincident external and clock", Tournament, true, true, true},
+		{"node stop", Tournament, true, false, true},
+		{"fixed move time", TimePerMove, true, true, false},
+		{"fixed depth", FixedDepth, true, true, false},
+		{"infinite", Infinite, true, true, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			tm := NewTimeManager()
+			tm.timeControl, tm.shouldStop = test.control, test.clockStopped
+			info := &SearchInfo{BestMove: old, BestScore: 15, Depth: 4, Stopped: test.stopped,
+				TimeManager: tm, control: &SearchControl{}}
+			if test.external {
+				info.control.RequestStop()
+			}
+			choice.retainOnClockStop(info)
+			if info.BestMove != old || info.BestScore != 15 || info.Depth != 4 {
+				t.Fatal("non-tournament-clock policy changed")
+			}
+		})
+	}
+}
+
+func TestPartialRootClockUnwindsPositionAndTT(t *testing.T) {
+	p := controlTestPosition(t)
+	before := snapshotEnPassantPosition(p)
+	searcher, err := NewSearchEngineWithHash(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	start := time.Unix(20261009, 0)
+	armed := false
+	checks := 0
+	tm := newTimeManager(func() time.Time {
+		if armed {
+			checks++
+			if checks >= 5 {
+				return start.Add(2 * time.Hour)
+			}
+		}
+		return start
+	})
+	tm.timeControl = Tournament
+	tm.startTime = start
+	tm.baseTime, tm.softTime, tm.hardTime = 3*time.Hour, time.Hour, 2*time.Hour
+	var completedDepth int
+	result := searcher.SearchIterativeDeepeningWithCallback(p, 8, tm, func(info *SearchInfo) {
+		completedDepth = info.Depth
+		if info.Depth == 4 {
+			armed = true
+		}
+	})
+	if !result.Stopped || result.Depth != completedDepth || completedDepth < 4 {
+		t.Fatalf("clock stop changed whole-depth accounting: stopped=%v depth=%d completed=%d", result.Stopped, result.Depth, completedDepth)
+	}
+	assertEnPassantPositionRestored(t, p, before)
+	if _, _, _, _, hit, _ := searcher.tt.Get(p.Hash()); hit {
+		t.Fatal("interrupted root stored a root TT entry")
+	}
+	if !slices.Contains(GenerateMoves(p), result.BestMove) {
+		t.Fatal("clock stop returned an unavailable root move")
+	}
+}
