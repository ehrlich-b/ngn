+	JNZ VNNI512_inputs
+	VEXTRACTI64X4 $1, Z0, Y4
+	VPADDD Y4, Y0, Y0
+	VEXTRACTI64X4 $1, Z1, Y4
+	VPADDD Y4, Y1, Y1
+	VEXTRACTI64X4 $1, Z2, Y4
+	VPADDD Y4, Y2, Y2
+	VEXTRACTI64X4 $1, Z3, Y4
+	VPADDD Y4, Y3, Y3
+	VEXTRACTI128 $1, Y0, X4
+	VPADDD X4, X0, X0
+	VEXTRACTI128 $1, Y1, X4
+	VPADDD X4, X1, X1
