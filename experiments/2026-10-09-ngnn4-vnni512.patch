+	VPDPBUSD (R9), Z4, Z1
+	VPDPBUSD (R10), Z4, Z2
+	VPDPBUSD (R11), Z4, Z3
+	ADDQ $64, SI
+	ADDQ $64, R8
+	ADDQ $64, R9
+	ADDQ $64, R10
+	ADDQ $64, R11
