+func ngnn4LinearRows(dst []int32, input []uint8, weights []int8) {
+	if ngnn4UseVNNI {
+		if len(input)%64 == 0 {
+			ngnn4LinearRowsVNNI512(dst, input, weights)
+		} else {
+			ngnn4LinearRowsVNNI(dst, input, weights)
+		}
