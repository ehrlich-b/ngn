@@ -0,0 +1,97 @@
+package engine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"os"
+	"testing"
+)
+
+// Exercise every retention field, modular age wrap and the distance cap against
+// the public decoder. Score/move/occupied/reserved bits must have no influence.
+func TestTTScanRetentionFields(t *testing.T) {
+	state := uint64(0x642071f3a891bcde)
+	for i := 0; i < 100000; i++ {
+		state ^= state << 13
+		state ^= state >> 7
+		state ^= state << 17
+		data, current := state, uint16(state>>37)
+		_, _, depth, bound, age, pv := Unpack(data)
+		distance := min(int((current-age)&255), 31)
+		want := 4*int(depth) - 8*distance
+		if bound == Exact {
+			want += 2
+		}
+		if pv {
+			want++
+		}
+		if got := ttRetention(data, current); got != want {
+			t.Fatalf("data %x generation %d: retention %d, want %d", data, current, got, want)
+		}
+	}
+}
+
+// This identical fixture runs on the pristine base and candidate on the box.
+// Dense colliding keys, zero keys, empty moves, repeated keys, generation wraps
+// and clears exercise the replacement path, including empty-slot tie order.
+func TestTTScanCollisionDump(t *testing.T) {
+	path := os.Getenv("NGN_TT_SCAN_DUMP")
+	if path == "" {
+		t.Skip("paired baseline/candidate trace only")
+	}
+	var out bytes.Buffer
+	put := func(value any) {
+		if err := binary.Write(&out, binary.LittleEndian, value); err != nil {
+			t.Fatal(err)
+		}
+	}
+	state := uint64(0x67c8be3490521adf)
+	next := func() uint64 {
+		state ^= state << 13
+		state ^= state >> 7
+		state ^= state << 17
+		return state
+	}
+	for _, mode := range []TTMode{TTDirect, TTSynchronized} {
+		c := newCacheWithMode(1, mode)
+		for i := 0; i < 20000; i++ {
+			v := next()
+			bucket, key := v&7, v>>8&15
+			hash := key*uint64(c.mask+1) | bucket
+			if i%7 == 0 {
+				c.AdvanceAge()
+			}
+			if i%7001 == 7000 {
+				c.Clear()
+			}
+			move := Move(next())
+			if i%5 == 0 {
+				move = EmptyMove
+			}
+			score, depth := int16(next()), int8(next())
+			bound, pv := NodeType(1+next()%3), next()&1 != 0
+			c.Set(hash, move, score, depth, bound, pv)
+			for key := uint64(0); key < 16; key++ {
+				m, score, depth, bound, hit, pv := c.Get(key*uint64(c.mask+1) | bucket)
+				put(uint32(m))
+				put(score)
+				put(depth)
+				put(uint8(bound))
+				put(hit)
+				put(pv)
+			}
+			first := c.index(hash)
+			for _, slot := range c.items[first : first+ttWays] {
+				put(slot.hash)
+				put(slot.payload)
+			}
+			if i%97 == 0 {
+				put(c.age)
+				put(int32(c.Consumed()))
+			}
+		}
+	}
+	if err := os.WriteFile(path, out.Bytes(), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
