+                    take = min(left, len(pending[source]))
+                    chunks.append(pending[source][:take])
+                    pending[source] = pending[source][take:]
+                    left -= take
+            self.batch_source_spans = spans
+            yield np.concatenate(chunks)
+            emitted += size
