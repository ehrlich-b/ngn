+    def set_source_weights(self, weights):
+        """Select source presentation shares independently of archive lengths.
+
+        Keys are the resolved archive paths. The default block-permutation
+        sampler is unchanged unless this method is explicitly called.
+        """
+        resolved = {str(Path(path).resolve()): float(value) for path, value in weights.items()}
+        if len(resolved) != len(weights) or set(resolved) != set(self.source_paths):
+            raise ValueError("Source weights must name each nonempty archive exactly once")
+        values = [resolved[path] for path in self.source_paths]
+        if any(not math.isfinite(value) or value <= 0 for value in values):
+            raise ValueError("Source weights must be finite and positive")
+        total = math.fsum(values)
+        if not math.isfinite(total):
+            raise ValueError("Source weight sum must be finite")
+        self.source_weights = [value / total for value in values]
+        for source in range(len(values)):
+            available = sum(end - start - len(self.heldout[index])
+                            for index, (shard, start, end) in enumerate(self.blocks) if shard == source)
+            if not available:
+                raise ValueError("A weighted source has no training records")
+
+    def _source_batches(self, source, batch_size, seed, shuffle):
+        # Each source has its own shuffle stream. Changing another source's
+        # size or contents therefore preserves this source's sampled rows.
+        view = object.__new__(Archive)
+        view.__dict__ = self.__dict__.copy()
+        chosen = [index for index, block in enumerate(self.blocks) if block[0] == source]
+        view.blocks = [self.blocks[index] for index in chosen]
+        view.heldout = [self.heldout[index] for index in chosen]
+        view.source_weights = None
+        cycle = 0
+        while True:
+            yield from view.batches(batch_size, seed + source * 1000000007 + cycle, shuffle)
+            cycle += 1
+
+    def _mixture_batches(self, batch_size, seed, shuffle):
+        """Seeded multinomial row quotas, independent per-source cycling.
+
+        A finite iteration emits count rows (with source-local resampling).
+        Quotas and source rows are deterministic for the epoch seed. This
+        lets a matched pair share the exact T80/T76 rows batch by batch while
+        replacing only T74. Actual admitted shares are recorded as exposures.
+        Holdout retains its original finite, unweighted enumeration.
+        """
+        rng = np.random.default_rng(seed)
+        streams = [iter(self._source_batches(source, batch_size, seed, shuffle))
+                   for source in range(len(self.source_weights))]
+        pending = [np.empty((0, 32), dtype=np.uint8) for _ in streams]
+        emitted = 0
+        while emitted < self.count:
+            size = min(batch_size, self.count - emitted)
+            quotas = rng.multinomial(size, self.source_weights)
+            chunks, spans = [], []
+            for source, quota in enumerate(quotas):
+                left = int(quota)
+                if left:
+                    spans.append((source, left))
+                while left:
