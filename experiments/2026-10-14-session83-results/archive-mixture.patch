index 0000000..ea75ef5
--- /dev/null
+++ b/trainer/tests/test_archive_mixture.py
@@ -0,0 +1,130 @@
+"""Matched source exposure, deterministic cycling and trainer resume on WSL."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from trainer.archive import ARCHIVE_DTYPE, Archive
+from trainer.ngnp import RECORD_DTYPE
+from trainer.tests.synthetic import random_records
+from trainer.tests.test_archive import archive_fixture
+from trainer.train import epoch_batches, prefetched
+
+
+class ArchiveMixtureTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.root = Path(self.temporary.name)
+        self.paths = []
+        for source, count in enumerate((257, 521, 73)):
+            records = np.asarray([archive_fixture(row) for row in random_records(
+                count, np.random.default_rng(700 + source))], dtype=ARCHIVE_DTYPE)
+            records['score'] = source * 1000 + np.arange(count)
+            path = self.root / f'source-{source}.bf'
+            records.tofile(path)
+            self.paths.append(str(path))
+        self.weights = dict(zip(self.paths, (.4535, .3321, .2144)))
+
+    def tearDown(self):
+        self.temporary.cleanup()
+
+    def reader(self, weighted=True):
+        archive = Archive(self.paths, block_records=31, seed=992, holdout_modulus=8)
+        if weighted:
+            archive.set_source_weights(self.weights)
+        return archive
+
+    def test_exact_exposures_tails_cycles_and_expected_shares(self):
+        for batch, positions in ((1, 51), (17, 301), (97, 100003), (4096, 1801)):
+            with self.subTest(batch=batch, positions=positions):
+                archive = self.reader()
+                rows = np.concatenate(list(prefetched(epoch_batches(archive, batch, positions, 123))))
+                scores = rows.copy().view(RECORD_DTYPE).reshape(-1)['score']
+                expected = np.bincount(scores // 1000, minlength=3).tolist()
+                self.assertEqual(archive.exposure_counts, expected)
+                self.assertEqual(sum(expected), positions)
+                validation = np.concatenate(list(archive.holdout().batches(19, 0, shuffle=False)))
+                self.assertEqual(archive.exposure_counts, expected)
+                self.assertFalse({bytes(row[:24]) for row in rows} &
+                                 {bytes(row[:24]) for row in validation})
+                if positions > 100000:
+                    np.testing.assert_allclose(np.asarray(expected) / positions,
+                                               list(self.weights.values()), atol=.008)
+
+    def test_seeded_bytes_and_unweighted_holdout_identity(self):
+        a, b, unweighted = self.reader(), self.reader(), self.reader(False)
+        first = np.concatenate(list(epoch_batches(a, 19, 1103, 123)))
+        repeat = np.concatenate(list(epoch_batches(b, 19, 1103, 123)))
+        np.testing.assert_array_equal(first, repeat)
+        for shuffle in (False, True):
+            np.testing.assert_array_equal(
+                np.concatenate(list(a.holdout().batches(19, 144, shuffle))),
+                np.concatenate(list(unweighted.holdout().batches(19, 144, shuffle))))
+        changed = np.concatenate(list(epoch_batches(self.reader(), 19, 1103, 124)))
+        self.assertFalse(np.array_equal(first, changed))
+
+    def test_matched_pair_keeps_other_sources_exact(self):
+        control = self.reader()
+        before = np.concatenate(list(epoch_batches(control, 19, 503, 123)))
+        # Change only source 2's diversity/size, preserving sources 0/1.
+        path = Path(self.paths[2])
+        records = np.fromfile(path, dtype=ARCHIVE_DTYPE)
+        np.concatenate((records, records[::-1], records)).tofile(path)
+        treatment = self.reader()
+        after = np.concatenate(list(epoch_batches(treatment, 19, 503, 123)))
+        before_scores = before.copy().view(RECORD_DTYPE).reshape(-1)['score']
+        after_scores = after.copy().view(RECORD_DTYPE).reshape(-1)['score']
+        for source in (0, 1):
+            np.testing.assert_array_equal(before[before_scores // 1000 == source],
+                                          after[after_scores // 1000 == source])
+        self.assertFalse(np.array_equal(before[before_scores // 1000 == 2],
+                                        after[after_scores // 1000 == 2]))
+
+    def test_weights_require_all_sources_and_valid_positive_values(self):
+        archive = self.reader(False)
+        for weights in ({self.paths[0]: 1}, dict(self.weights, missing=1),
+                        dict(self.weights, **{self.paths[0]: 0}),
+                        dict(self.weights, **{self.paths[0]: -1}),
+                        dict(self.weights, **{self.paths[0]: float('nan')}),
+                        dict(self.weights, **{self.paths[0]: float('inf')})):
+            with self.assertRaises(ValueError):
+                archive.set_source_weights(weights)
+
+    def test_training_resume_matches_and_binds_weight_contents(self):
+        weights = self.root / 'weights.json'
+        weights.write_text(json.dumps(self.weights))
+        command = [sys.executable, '-m', 'trainer.train', '--data', *self.paths,
+                   '--data-format', 'archive', '--archive-source-weights', str(weights),
+                   '--archive-holdout-modulus', '8', '--archive-split-seed', '992',
+                   '--block-records', '31', '--hidden', '16', '--batch', '19',
+                   '--positions-per-epoch', '103', '--device', 'cpu', '--threads', '2',
+                   '--precision', 'fp32', '--decay', 'none']
+        for out, epochs, resume in [('full', 2, None), ('resumed', 1, None),
+                                    ('resumed', 2, self.root / 'resumed/epoch-0001.pt')]:
+            argv = command + ['--out', str(self.root / out), '--epochs', str(epochs)]
+            if resume:
+                argv += ['--resume', str(resume)]
+            run = subprocess.run(argv, capture_output=True, text=True, timeout=60)
+            self.assertEqual(run.returncode, 0, run.stderr)
+        full = torch.load(self.root / 'full/epoch-0002.pt', weights_only=True)
+        resumed = torch.load(self.root / 'resumed/epoch-0002.pt', weights_only=True)
+        for key in full['model']:
+            self.assertTrue(torch.equal(full['model'][key], resumed['model'][key]), key)
+        self.assertEqual(full['history'][-1]['loss'], resumed['history'][-1]['loss'])
+        self.assertEqual(full['history'][-1]['source_presentations_cumulative'],
+                         resumed['history'][-1]['source_presentations_cumulative'])
+        weights.write_text(json.dumps(dict(zip(self.paths, (.3, .4, .3)))))
+        rejected = subprocess.run(command + ['--out', str(self.root / 'resumed'), '--epochs', '2',
+                                              '--resume', str(self.root / 'resumed/epoch-0002.pt')],
+                                  capture_output=True, text=True, timeout=60)
+        self.assertNotEqual(rejected.returncode, 0)
+        self.assertIn('archive_source_mixture', rejected.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
